{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraeBuddy Keeper",
  "version": "0.1.5",
  "identifier": "com.traebuddy.keeper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TraeBuddy Keeper",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Yqxnice/trae-buddy-keeper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQzZCQTlBQUU4NTgwNTcKUldSWGdJV3VtcnJHWDFHQXBwRFVLT0dmcm80cFg5c3I0TnpMVXBqWlBDZk8wYkVkSi94WVdsdkMK"
    }
  }
}
